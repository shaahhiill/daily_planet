# Environment variables for local development
# Copy this file to .env and fill in your actual API keys
# These will NEVER be committed to Git - they live in Vercel's dashboard in production

NEWS_API_KEY=your_newsapi_key_here
WEATHER_API_KEY=your_openweathermap_key_here

# Optional: restrict which origins can call your API (your Flutter app's bundle ID or domain)
# Leave blank during development to allow all origins
ALLOWED_ORIGIN=*
